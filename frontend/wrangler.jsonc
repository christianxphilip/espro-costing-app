{
  "name": "espro-costing-app",
  "main": "./worker.mjs",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  }
}
